// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  runtime    = "nodejs"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum PackageCategory {
  Beach
  Hill
  Heritage
  Pilgrimage
  International
  Honeymoon
  Family
}

enum PackageStatus {
  active
  inactive
}

// ── Destination / Category lookup tables ─────────────────────────────────────
// Step 1 of the package redesign. Standalone for now; linking them to Package
// happens later, once Package itself is changed.

model Destination {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  state   String?
  country String

  stays PackageStay[]

  @@index([country])
}

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
}

// ── Package ───────────────────────────────────────────────────────────────────

model Package {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  destination     String
  category        PackageCategory
  status          PackageStatus   @default(active)
  durationDays    Int
  durationNights  Int
  pricePerPerson  Int
  // Lowest variant price per person, kept in sync when prices change.
  // Used for sorting/filtering; pricePerPerson is retired in the cleanup step.
  startingPrice   Int             @default(0)
  variants        PackageVariant[]
  images         String[]        @default([])
  summary         String
  highlights      String[]
  inclusions      String[]
  exclusions      String[]
  popularityScore Int             @default(0)
  itinerary       ItineraryItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([category])
  @@index([status])
  @@index([destination])
}

// ── Variants, stays and pricing ───────────────────────────────────────────────
// A package has one or more variants (Standard / Deluxe / Premium). Each variant
// is priced either as one flat per-person price, or per group size (2, 4, 6...).
// App-level rules: flat -> flatPrice required; group_size -> at least one
// VariantPrice; stay nights per variant sum to Package.durationNights.

enum PricingMode {
  flat
  group_size
}

model PackageVariant {
  id          String      @id @default(cuid())
  package     Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String
  name        String
  sortOrder   Int         @default(0)
  pricingMode PricingMode @default(flat)
  flatPrice   Int?

  stays  PackageStay[]
  prices VariantPrice[]

  @@unique([packageId, name])
}

// Price per person when travelling in a group of `persons`.
model VariantPrice {
  id             String         @id @default(cuid())
  variant        PackageVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId      String
  persons        Int
  pricePerPerson Int

  @@unique([variantId, persons])
}

// One stop in a variant's route: "2N Shimla", "3N Manali".
model PackageStay {
  id            String         @id @default(cuid())
  variant       PackageVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId     String
  destination   Destination    @relation(fields: [destinationId], references: [id])
  destinationId String
  nights        Int
  hotelName     String
  hotelCategory String?
  roomType      String?
  sortOrder     Int            @default(0)

  @@index([variantId, sortOrder])
  @@index([destinationId])
}

// ── ItineraryItem ─────────────────────────────────────────────────────────────
// Separate model because each day has multiple fields (day, title, description).
// Stored as a relation so days can be queried, filtered, and updated independently.

model ItineraryItem {
  id          Int     @id @default(autoincrement())
  day         Int
  title       String
  description String
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String

  @@unique([packageId, day])
  @@index([packageId])
}

// ── SiteSettings ──────────────────────────────────────────────────────────────
// Singleton row (id=1). Always upserted with where: { id: 1 }.

model SiteSettings {
  id Int @id @default(1)

  siteName       String
  phone          String
  email          String
  whatsappNumber String
  address        String

  heroEyebrow    String
  heroHeading    String
  heroSubheading String

  aboutHeading       String
  aboutDescription   String
  missionHeading     String
  missionDescription String

  stats        Json
  testimonials Json

  footerTagline String

  updatedAt DateTime @updatedAt
}
